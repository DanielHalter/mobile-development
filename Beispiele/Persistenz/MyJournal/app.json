{
  "expo": {
    "name": "Persistenz",
    "slug": "Persistenz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "persistenz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MyJournal benötigt die Kamera, um Fotos zu Tagebucheinträgen aufzunehmen."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MyJournal speichert zum Eintrag das Wetter am aktuellen Standort."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
